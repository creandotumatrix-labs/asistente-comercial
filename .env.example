# ── Server ────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080
RUST_LOG=asistente_comercial=info,tower_http=warn
# Path to the white-label offer config (qualification rubric, calendar, branding)
OFFER_CONFIG_PATH=config/offer.json
# Public base URL of this service (used to build transcript links for handoff)
PUBLIC_BASE_URL=https://your-deploy.example.com

# ── Postgres ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://asistente:asistente@localhost:5432/asistente
# Run embedded migrations on boot (true for the demo, false if you manage them out-of-band)
RUN_MIGRATIONS=true

# ── Anthropic (agent brain) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=1024

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# From Meta App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_GRAPH_VERSION=v21.0
# You choose this string; it must match what you type into the Meta webhook config
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
# Meta App Secret (App > Settings > Basic). When set, inbound webhooks are rejected
# unless they carry a valid X-Hub-Signature-256. Leave blank for the test-number demo.
WHATSAPP_APP_SECRET=

# ── Google Calendar (service account) ───────────────────────────────────────
# Either inline the JSON (single line) OR point to a file path. Inline wins if set.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_PATH=secrets/google-service-account.json

# ── CRM ─────────────────────────────────────────────────────────────────────
# CRM_BACKEND = hubspot | webhook
CRM_BACKEND=hubspot
# HubSpot private app token (scopes: crm.objects.contacts.write, crm.objects.deals.write)
HUBSPOT_TOKEN=pat-na1-...
# HubSpot deal pipeline + stage IDs for newly routed leads (defaults shown are HubSpot's stock ids)
HUBSPOT_PIPELINE=default
HUBSPOT_DEALSTAGE=appointmentscheduled
# For CRM_BACKEND=webhook, leads are POSTed here as JSON instead
CRM_WEBHOOK_URL=
